OPENAI_API_KEY=
RULEBOOK_MODEL=openai:gpt-4o-mini
RULEBOOK_RUN_TIMEOUT_MS=90000
# Extra Host names the API serves besides localhost (comma-separated), e.g. for a hosted demo
RULEBOOK_ALLOWED_HOSTS=
# AI spend limit in USD; new runs are refused once the saved total reaches it
RULEBOOK_BUDGET_USD=5
# Your country as a market code; "same country as me" in the Check page means this
RULEBOOK_HOME_MARKET=IN
# Where the agent workspace repo lives (default ./workspace)
RULEBOOK_WORKSPACE=
